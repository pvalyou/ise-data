  "widgetMetadata": {
    "instructions": "Each entry under `widgets` describes one chart/widget rendered on this page of the Israeli Ecosystem dashboard. Descriptions are result-agnostic: they explain what the visualization shows and how to interpret it, not the specific numbers. The `dataPaths` array on each entry lists dot-notation paths inside this same JSON file where the underlying data for that widget lives (e.g. \"kpis.patentingStartups\" or \"ipIntensity.items\") When summarizing or answering questions about a number from this snapshot, locate the relevant widget(s) by `dataPaths` and quote the corresponding `description` to explain the metric. Widgets that have a 10 year trend usually show the total overall (across all years) and you get the exact data for each year in the past 10 years. The 10 year data do not add up to the total of course",
    "widgets": {
      "angels:kpi-angels": {
        "title": "Angels",
        "description": "Total number of individuals identified as angel investors in the Israeli startup population. The sparkline shows how many wrote their first ever recorded check in each of the last ten years, so it tracks new entrants rather than everyone active in a year.",
        "dataPaths": [
          "angels.total",
          "byYear.years",
          "byYear.newAngels"
        ]
      },
      "angels:kpi-investments": {
        "title": "Investments",
        "description": "Total angel-company pairings, counting each company once per angel however many rounds they joined. The bars show investments per year, where the solid portion was made by angels writing their first ever check and the outline above it is repeat activity from angels already in the data.",
        "dataPaths": [
          "angels.investments",
          "byYear.years",
          "byYear.investments",
          "byYear.newAngels"
        ]
      },
      "angels:kpi-companies": {
        "title": "Companies Backed",
        "description": "Distinct companies in the Israeli startup population with at least one identified angel behind them. The sparkline counts companies receiving their first angel check each year, so a company appears once however many angels back it later.",
        "dataPaths": [
          "angels.startupsBacked",
          "byYear.years",
          "byYear.newCompanies"
        ]
      },
      "angels:kpi-age": {
        "title": "Age at First Check",
        "description": "How old angels were when they made their first recorded investment, in five-year bands from 25 with an open final band. The source carries no birth date, so age is reconstructed from a person\u2019s age when they founded a company against that company\u2019s founding year, which means it only exists for angels who are also founders. The covered share is stated on the card.",
        "dataPaths": [
          "ageAtFirstCheck"
        ]
      },
      "angels:kpi-exit-lag": {
        "title": "Exit to First Check",
        "description": "How many years passed between a founder exit and that person\u2019s first angel investment, in two-year bands with an open final band and the median called out. The population is only angels who founded a company that was acquired or went public, and the covered count against that population is stated on the card. Angels whose first check predates their exit fall outside the measured set.",
        "dataPaths": [
          "exitToFirstCheck"
        ]
      },
      "angels:profile": {
        "title": "Startup Experience",
        "description": "What these people did before they started writing cheques. The donut splits every angel into three tiers by founder background: never founded, founded without an exit, founded and exited. The centre reads the founded share at rest, and on hover names the tier under the cursor with its mean investments per angel, which is what shows whether founding and exiting changes how much someone invests.",
        "dataPaths": [
          "profile.tiers",
          "profile.angelBeforeExit"
        ]
      },
      "angels:dna": {
        "title": "Angel DNA",
        "description": "The share of angels with a technical versus a non-technical background, over the angels with a known classification. Same technical / non-technical axis the founders page uses, so the two are comparable. Technical means an affirmatively technical background; non-technical is everyone else, not a named function.",
        "dataPaths": [
          "profile.dnaTechnical",
          "profile.dnaNonTechnical",
          "profile.dnaKnown"
        ]
      },
      "angels:geography": {
        "title": "Where Angels Are Based",
        "description": "Where the angels backing Israeli startups are based, split into Israel, the United States and the rest of the world, each with its angel count, mean investments per angel and the number of companies it reaches. Country aliases are folded together first. A large share sit outside Israel, which is diaspora and foreign capital reaching Israeli companies. Angels with no recorded country are reported separately rather than folded into the rest.",
        "dataPaths": [
          "geography.groups",
          "geography.known",
          "geography.unknown",
          "geography.countries"
        ]
      },
      "angels:top-backed": {
        "title": "Most Angel-Backed Startups",
        "description": "The startups that convinced the most angels, counted as distinct individual investors per company across the whole angel population this page describes. One angel backing a company across several rounds still counts once. Ties sit alphabetically so the board is stable between updates. This board replaced a list of named individual angels: the same concentration story, told from the company side.",
        "dataPaths": [
          "topBacked"
        ]
      },
      "angels:employers": {
        "title": "Where Angels Worked",
        "description": "The most common prior employers among angels, counted once per person per employer. A person\u2019s own founder roles are excluded, schools are excluded so they cannot leak in from the employer side, and membership networks and advisory councils are excluded as affiliations rather than jobs. Built like the founders page equivalent, so the two are comparable.",
        "dataPaths": [
          "employers.items",
          "employers.coveredAngels"
        ]
      },
      "angels:schools": {
        "title": "Where Angels Studied",
        "description": "The most common institutions angels attended, counted once per person per school. Shares are against the angels with a recorded school rather than all angels. Built like the founders page equivalent, so the two are comparable.",
        "dataPaths": [
          "schools.items",
          "schools.coveredAngels"
        ]
      },
      "angels:gender": {
        "title": "Gender",
        "description": "The gender split among identified angels, over the angels with a known value. This became reportable only after an enrichment backfill took coverage from roughly 45% to 99%; before that the field was populated for angels who are also founders and almost nobody else. The share of women here runs below the equivalent share among founders.",
        "dataPaths": [
          "gender"
        ]
      },
      "angels:portfolio-distribution": {
        "title": "Investments per Angel",
        "description": "How concentrated angel activity is: the number of angels who made 1, 2, 3-4, 5-9, or 10 or more investments, with the share of all investments each group accounts for. Reads as a power law, where most identified angels appear once and a small group carries a disproportionate share of the deals.",
        "dataPaths": [
          "portfolioDistribution"
        ]
      },
      "angels:stage-mix": {
        "title": "Where Angels Enter",
        "description": "The funding stage of every equity round an angel joined, drawn as a centred funnel in ladder order from pre-seed upward, with band width and fill depth both carrying the number of rounds. Rounds labelled Angel are counted as pre-seed: they are one rung under two names, rarely appear at the same company, sit the same distance before that company's seed, and draw the same investors. SAFEs, convertible notes and bridges are instruments rather than stages, so they group under Other and stay off the ladder. A round with several identified angels counts once per angel.",
        "dataPaths": [
          "stageMix"
        ]
      },
      "angels:sectors": {
        "title": "Where Angels Invest",
        "description": "Angel-backed companies grouped by subindustry as a circle pack, each bubble sized by the angel investments that went into it and coloured by its parent industry. Counted per angel and company pair, so a company backed by three angels contributes three. Hovering a bubble gives that subindustry's share of all angel investments, its angels and backed companies, and how those companies turned out: median raised among those that disclose, and how many reached an acquisition or listing.",
        "dataPaths": [
          "sectors"
        ]
      },
      "angels:coverage": {
        "title": "Coverage",
        "description": "How much of the Israeli startup population has an identified angel behind it. Angel names in the source data are raw strings, and only the ones that resolve to a real person are counted here, so roughly half the individual investor names in the source are not represented. Every number on this page is therefore a floor rather than a complete count of Israeli angel activity.",
        "dataPaths": [
          "angels.total",
          "angels.startupsBacked",
          "angels.investments",
          "angels.populationStartups"
        ]
      }
    }
  },
